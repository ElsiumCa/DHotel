{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "frontdesk-checkout-route": {
        "ClusterId": "frontdesk-cluster",
        "Match": {
          "Path": "/api/checkout/{**catch-all}"
        }
      },
      "frontdesk-checkin-route": {
        "ClusterId": "frontdesk-cluster",
        "Match": {
          "Path": "/api/checkin/{**catch-all}"
        }
      },
      "housekeeping-route": {
        "ClusterId": "housekeeping-cluster",
        "Match": {
          "Path": "/api/housekeeping/{**catch-all}"
        }
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/maintenance/{**catch-all}"
        }
      },
      "saga-route": {
        "ClusterId": "saga-cluster",
        "Match": {
          "Path": "/api/saga/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "frontdesk-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "housekeeping-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "saga-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5005"
          }
        }
      }
    }
  }
}
